# =============================================================================
# YourHomeCare — Environment Variables
# Copy to .env.local (local) or configure in Hostinger / PM2 ecosystem
# =============================================================================

# --- Database (Supabase Postgres or any Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Authentication (required in production) ---
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@yourhomecare.co.ke
ADMIN_PASSWORD=ChangeMeToAStrongPassword!

# --- Supabase (optional; enables remote table fallback) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=info@yourhomecare.co.ke

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Monitoring (optional) ---
SENTRY_DSN=

# --- Runtime ---
# Do NOT set NODE_ENV in .env for local development.
# `next dev` must run as development; NODE_ENV=production causes universal 404s.
# For Hostinger/PM2, set NODE_ENV=production in ecosystem.config.cjs (already set there).
PORT=3000
# Local:
# NEXTAUTH_URL=http://localhost:3000
# VERCEL_URL=http://localhost:3000
# Production:
# NEXTAUTH_URL=https://yourhomecare.co.ke
# VERCEL_URL=https://yourhomecare.co.ke
VERCEL_URL=http://localhost:3000
