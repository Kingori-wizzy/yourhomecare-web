# =============================================================================
# YourHomeCare — Environment Variables
# Copy to .env.local (local) or configure in Hostinger / PM2 ecosystem
# =============================================================================

# --- Database (Supabase Postgres or any Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Authentication (required in production) ---
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=https://yourhomecare.co.ke
ADMIN_EMAIL=admin@yourhomecare.co.ke
ADMIN_PASSWORD=ChangeMeToAStrongPassword!

# --- Supabase (optional; enables remote table fallback) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=info@yourhomecare.co.ke

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Monitoring (optional) ---
SENTRY_DSN=

# --- Runtime ---
NODE_ENV=production
PORT=3000
VERCEL_URL=https://yourhomecare.co.ke
